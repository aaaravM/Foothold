---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	gather_constraints(gather_constraints)
	retrieve_programs(retrieve_programs)
	translate_rules(translate_rules)
	confirm_rules(confirm_rules)
	solve(solve)
	verify(verify)
	propose(propose)
	approval(approval)
	learn_from_rejection(learn_from_rejection)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> gather_constraints;
	approval -.-> __end__;
	approval -.-> finalize;
	approval -.-> learn_from_rejection;
	confirm_rules --> solve;
	gather_constraints --> retrieve_programs;
	learn_from_rejection --> solve;
	propose --> approval;
	retrieve_programs --> translate_rules;
	solve --> verify;
	translate_rules --> confirm_rules;
	verify --> propose;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
