# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# A current small, fast OpenAI model id (see https://developers.openai.com/api/docs/models)
OPENAI_MODEL=
# Optional: tried if the primary model errors
OPENAI_FALLBACK_MODEL=
# none | low | medium | high (no temperature/top_p is sent)
OPENAI_REASONING_EFFORT=low
# auto = OpenAI if the key works, else deterministic mock; openai | mock to force
LLM_MODE=auto
# 1 = serve only cached LLM responses (demo golden path, works offline)
DEMO_MODE=0
# Optional: path to the Python interpreter of the project venv (defaults to .venv)
FOOTHOLD_PY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional, free from https://api.data.gov/signup/ (DEMO_KEY is used otherwise)
COLLEGE_SCORECARD_API_KEY=
# Signs per-tab session tokens (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
AUTH_SECRET=
# Supabase (optional; see supabase/README.md). Server-side only: the secret key must start with sb_secret_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# auto = Supabase mirror when URL + secret key are set and the tables exist, else sqlite | supabase | sqlite
DB_BACKEND=auto
# Optional: extra Host names (LAN demos); CORS already allows *.netlify.app and *.trycloudflare.com
FOOTHOLD_ALLOWED_HOSTS=
