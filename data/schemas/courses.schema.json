{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foothold.local/schemas/courses.schema.json",
  "title": "Foothold learning resources",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "provider",
      "cost_usd",
      "hours",
      "skills",
      "url",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "provider": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "course",
          "book",
          "guide",
          "tool",
          "program",
          "certification"
        ]
      },
      "cost_usd": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "hours": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "hours_status": {
        "enum": [
          "REAL",
          "SAMPLE",
          "SYNTHETIC",
          "FICTIONAL"
        ]
      },
      "skills": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "url": {
        "type": "string",
        "pattern": "^https?://"
      },
      "verify_url": {
        "type": "string",
        "pattern": "^https?://"
      },
      "status": {
        "enum": [
          "REAL",
          "SAMPLE",
          "SYNTHETIC",
          "FICTIONAL"
        ]
      },
      "retrieved": {
        "type": [
          "string",
          "null"
        ]
      },
      "source_id": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
