{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foothold.local/schemas/event.schema.json",
  "title": "Foothold sim event",
  "description": "One workday scenario for the Try-the-job sim (docs/CONTRACTS.md section 5). Generated by data/build_processed.py: trait ids come from data/processed/traits.json and coworker ids from data/processed/careers.json. events.json wraps these as {schema_version: 1, status, events: [Event]}. Every choice carries coworker_hints (use {} when no coworker reacts). A crunch event may leave career_ids empty, meaning it can appear in any career; a non-crunch event needs at least one career.",
  "type": "object",
  "required": [
    "event_id",
    "career_ids",
    "clock",
    "title",
    "text",
    "crunch",
    "status",
    "choices"
  ],
  "if": {
    "properties": {
      "crunch": {
        "const": false
      }
    },
    "required": [
      "crunch"
    ]
  },
  "then": {
    "properties": {
      "career_ids": {
        "minItems": 1
      }
    }
  },
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 48
    },
    "career_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "logistics_lead",
          "registered_nurse",
          "diesel_mechanic",
          "welder",
          "electrician",
          "software_dev",
          "farm_ops_manager",
          "robotics_tech"
        ]
      },
      "description": "careers this event belongs to; may be empty only when crunch is true"
    },
    "clock": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "24-hour HH:MM time of day in the sim"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 20,
      "maxLength": 900,
      "description": "Scenario, 2-4 sentences"
    },
    "crunch": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "DRAFT — needs human review"
      ]
    },
    "choices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/choice"
      },
      "description": "Exactly 3 choices; choice_id values must be unique within the event"
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "required": [
        "choice_id",
        "text",
        "trait_deltas",
        "stat_deltas",
        "coworker_hints"
      ],
      "properties": {
        "choice_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,16}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "trait_deltas": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 4,
          "propertyNames": {
            "enum": [
              "innovation",
              "achievement_orientation",
              "intellectual_curiosity",
              "tolerance_for_ambiguity",
              "initiative",
              "adaptability",
              "self_confidence",
              "perseverance",
              "leadership_orientation",
              "humility",
              "sincerity",
              "empathy",
              "cooperation",
              "optimism",
              "social_orientation",
              "cautiousness",
              "attention_to_detail",
              "dependability",
              "integrity",
              "stress_tolerance",
              "self_control"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "description": "2-4 traits, each delta in [-1, 1]"
        },
        "stat_deltas": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "safety",
              "output",
              "team_trust",
              "stress"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -15,
            "maximum": 15
          },
          "description": "integer deltas in [-15, 15] for safety, output, team_trust, stress"
        },
        "coworker_hints": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "rosa_delgado",
              "tou_vang",
              "darnell_hayes",
              "grace_villanueva",
              "harpreet_sandhu",
              "luz_herrera",
              "manny_soares",
              "pao_xiong",
              "brenda_ochoa",
              "ernesto_ruiz",
              "kayla_brooks",
              "arman_petrosyan",
              "dale_nakamura",
              "yesenia_cruz",
              "ninos_youkhana",
              "priya_raman",
              "marcus_bell",
              "sokha_chhim",
              "lupe_mendoza",
              "dirk_visser",
              "navdeep_kaur",
              "alejandro_ibarra",
              "mai_thao",
              "trevor_hall"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "description": "coworker id (careers.json) -> how that coworker tends to feel about this choice; required on every choice, {} allowed"
        }
      }
    }
  }
}
