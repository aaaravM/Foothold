{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foothold.local/schemas/jobs.schema.json",
  "title": "Foothold job nodes",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "career_id",
      "required_skills",
      "level"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "career_id": {
        "enum": [
          "logistics_lead",
          "registered_nurse",
          "diesel_mechanic",
          "welder",
          "electrician",
          "software_dev",
          "farm_ops_manager",
          "robotics_tech"
        ]
      },
      "level": {
        "enum": [
          "entry",
          "mid",
          "senior"
        ]
      },
      "required_skills": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "leads_to": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "onet_soc": {
        "type": "string",
        "pattern": "^\\d{2}-\\d{4}\\.\\d{2}$"
      },
      "status": {
        "enum": [
          "REAL",
          "SAMPLE",
          "SYNTHETIC",
          "FICTIONAL"
        ]
      },
      "source_id": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
