{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foothold.local/schemas/careers.schema.json",
  "title": "Foothold careers",
  "type": "array",
  "minItems": 8,
  "maxItems": 8,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "onet_soc",
      "onet_title",
      "summary",
      "path_types",
      "work_styles",
      "skills",
      "wage",
      "outlook",
      "coworkers"
    ],
    "properties": {
      "id": {
        "enum": [
          "logistics_lead",
          "registered_nurse",
          "diesel_mechanic",
          "welder",
          "electrician",
          "software_dev",
          "farm_ops_manager",
          "robotics_tech"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "onet_soc": {
        "type": "string",
        "pattern": "^\\d{2}-\\d{4}\\.\\d{2}$"
      },
      "onet_title": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 20
      },
      "path_types": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "cc_transfer",
            "certificate",
            "apprenticeship",
            "direct_to_work"
          ]
        }
      },
      "work_styles": {
        "type": "object",
        "required": [
          "innovation",
          "achievement_orientation",
          "intellectual_curiosity",
          "tolerance_for_ambiguity",
          "initiative",
          "adaptability",
          "self_confidence",
          "perseverance",
          "leadership_orientation",
          "humility",
          "sincerity",
          "empathy",
          "cooperation",
          "optimism",
          "social_orientation",
          "cautiousness",
          "attention_to_detail",
          "dependability",
          "integrity",
          "stress_tolerance",
          "self_control"
        ],
        "propertyNames": {
          "enum": [
            "innovation",
            "achievement_orientation",
            "intellectual_curiosity",
            "tolerance_for_ambiguity",
            "initiative",
            "adaptability",
            "self_confidence",
            "perseverance",
            "leadership_orientation",
            "humility",
            "sincerity",
            "empathy",
            "cooperation",
            "optimism",
            "social_orientation",
            "cautiousness",
            "attention_to_detail",
            "dependability",
            "integrity",
            "stress_tolerance",
            "self_control"
          ]
        },
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "skills": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "wage": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "median_hourly",
          "median_annual",
          "p25_annual",
          "p75_annual",
          "area",
          "period",
          "source_id",
          "status"
        ],
        "properties": {
          "median_hourly": {
            "type": [
              "number",
              "null"
            ]
          },
          "median_annual": {
            "type": [
              "number",
              "null"
            ]
          },
          "p25_annual": {
            "type": [
              "number",
              "null"
            ]
          },
          "p75_annual": {
            "type": [
              "number",
              "null"
            ]
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REAL",
              "SAMPLE",
              "SYNTHETIC",
              "FICTIONAL"
            ]
          }
        }
      },
      "outlook": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "growth_pct",
          "annual_openings",
          "period",
          "source_id",
          "status"
        ],
        "properties": {
          "growth_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "annual_openings": {
            "type": [
              "number",
              "null"
            ]
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REAL",
              "SAMPLE",
              "SYNTHETIC",
              "FICTIONAL"
            ]
          }
        }
      },
      "coworkers": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "role",
            "style",
            "base_mood"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "style": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "base_mood": {
              "enum": [
                "calm",
                "tense",
                "upbeat",
                "tired",
                "skeptical"
              ]
            },
            "pronouns": {
              "type": "string",
              "minLength": 1
            },
            "fictional": {
              "const": true
            }
          }
        }
      }
    }
  }
}
