{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foothold.local/schemas/skills.schema.json",
  "title": "Foothold skills",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "kind": {
        "enum": [
          "essential",
          "transferable",
          "job_specific"
        ]
      },
      "source": {
        "enum": [
          "O*NET 31.0",
          "Foothold taxonomy"
        ]
      },
      "onet_element_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "description": {
        "type": "string"
      },
      "credit": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
